{
  "schemaVersion": "1.0",
  "sdkVersion": "1.0",
  "code": "vehicle-parking-package",
  "version": "1.0.1",
  "name": "车辆违停检测",
  "category": "REGION",
  "eventType": "VEHICLE_STATIONARY",
  "description": "检测禁停区域内持续静止的车辆，过滤经过车辆和短暂停留。",
  "entrypoint": "processor.py",
  "timeoutMillis": 5000,
  "models": [
    {
      "slot": "primary",
      "name": "车辆检测模型",
      "taskType": "OBJECT_DETECTION",
      "formats": [
        "ONNX",
        "RKNN"
      ],
      "labels": [
        "car",
        "truck",
        "bus"
      ]
    }
  ],
  "parameterSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "vehicleConfidence": {
        "type": "number",
        "title": "车辆置信度",
        "minimum": 0.01,
        "maximum": 1,
        "description": "低于此值的检测结果不参与告警。"
      }
    },
    "required": [
      "vehicleConfidence"
    ]
  },
  "defaultParameters": {
    "vehicleConfidence": 0.5
  },
  "defaultRule": {
    "schemaVersion": "1.0",
    "eventType": "VEHICLE_STATIONARY",
    "severity": "MAJOR",
    "cooldownSeconds": 60,
    "recoverySeconds": 5,
    "dedup": {
      "scope": "TRACK",
      "windowSeconds": 60
    },
    "schedule": {
      "timezone": "Asia/Shanghai",
      "weekly": [
        {
          "days": [
            1,
            2,
            3,
            4,
            5,
            6,
            7
          ],
          "start": "00:00",
          "end": "23:59"
        }
      ]
    },
    "regions": [
      {
        "id": "main",
        "name": "检测区域",
        "type": "POLYGON",
        "pointMode": "CENTROID",
        "overlapThreshold": 0.2,
        "sourceWidth": 1920,
        "sourceHeight": 1080,
        "points": [
          {
            "x": 0,
            "y": 0
          },
          {
            "x": 1,
            "y": 0
          },
          {
            "x": 1,
            "y": 1
          },
          {
            "x": 0,
            "y": 1
          }
        ]
      }
    ],
    "condition": {
      "type": "AND",
      "children": [
        {
          "type": "ROI_ENTER",
          "regionId": "main",
          "objectClasses": [
            "car",
            "truck",
            "bus"
          ]
        },
        {
          "type": "STATIONARY",
          "maxMovement": 0.02
        },
        {
          "type": "N_OF_M",
          "n": 3,
          "m": 5
        },
        {
          "type": "DURATION",
          "seconds": 120
        }
      ]
    }
  }
}
