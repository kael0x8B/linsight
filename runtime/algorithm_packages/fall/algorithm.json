{
  "schemaVersion": "1.0",
  "sdkVersion": "1.0",
  "code": "fall-detection-package",
  "version": "1.0.0",
  "name": "跌倒检测",
  "category": "BEHAVIOR",
  "eventType": "FALL",
  "description": "检测跌倒姿态，连续确认后告警；需要具有跌倒类别的模型。",
  "entrypoint": "processor.py",
  "timeoutMillis": 5000,
  "models": [
    {
      "slot": "primary",
      "name": "跌倒姿态模型",
      "taskType": "OBJECT_DETECTION",
      "formats": [
        "ONNX",
        "RKNN"
      ],
      "labels": [
        "fall"
      ]
    }
  ],
  "parameterSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "fallConfidence": {
        "type": "number",
        "title": "跌倒置信度",
        "minimum": 0.01,
        "maximum": 1,
        "description": "低于此值的检测结果不参与告警。"
      }
    },
    "required": [
      "fallConfidence"
    ]
  },
  "defaultParameters": {
    "fallConfidence": 0.6
  },
  "defaultRule": {
    "schemaVersion": "1.0",
    "eventType": "FALL",
    "severity": "MAJOR",
    "cooldownSeconds": 60,
    "recoverySeconds": 5,
    "dedup": {
      "scope": "TRACK",
      "windowSeconds": 60
    },
    "schedule": {
      "timezone": "Asia/Shanghai",
      "weekly": [
        {
          "days": [
            1,
            2,
            3,
            4,
            5,
            6,
            7
          ],
          "start": "00:00",
          "end": "23:59"
        }
      ]
    },
    "regions": [
      {
        "id": "main",
        "name": "检测区域",
        "type": "POLYGON",
        "pointMode": "CENTROID",
        "overlapThreshold": 0.2,
        "sourceWidth": 1920,
        "sourceHeight": 1080,
        "points": [
          {
            "x": 0,
            "y": 0
          },
          {
            "x": 1,
            "y": 0
          },
          {
            "x": 1,
            "y": 1
          },
          {
            "x": 0,
            "y": 1
          }
        ]
      }
    ],
    "condition": {
      "type": "AND",
      "children": [
        {
          "type": "ROI_ENTER",
          "regionId": "main",
          "objectClasses": [
            "fall"
          ]
        },
        {
          "type": "N_OF_M",
          "n": 3,
          "m": 5
        },
        {
          "type": "DURATION",
          "seconds": 2
        }
      ]
    }
  }
}
