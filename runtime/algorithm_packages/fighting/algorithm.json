{
  "schemaVersion": "1.0",
  "sdkVersion": "1.0",
  "code": "fighting-assist-package",
  "version": "1.0.1",
  "name": "疑似打架检测",
  "category": "BEHAVIOR",
  "eventType": "FIGHTING",
  "description": "组合人员检测与行为分类，检测近邻多人区域内持续出现的疑似打架；需人工复核，拥抱、作业协作等可能误报。",
  "entrypoint": "processor.py",
  "timeoutMillis": 15000,
  "models": [
    {
      "slot": "person",
      "name": "人员检测模型",
      "taskType": "OBJECT_DETECTION",
      "formats": [
        "ONNX",
        "RKNN"
      ],
      "labels": [
        "person"
      ]
    },
    {
      "slot": "action",
      "name": "行为分类模型",
      "taskType": "CLASSIFICATION",
      "formats": [
        "ONNX"
      ],
      "labels": [
        "fighting"
      ]
    }
  ],
  "parameterSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "personConfidence",
      "fightConfidence",
      "maxPairs"
    ],
    "properties": {
      "personConfidence": {
        "type": "number",
        "title": "人员置信度",
        "minimum": 0.01,
        "maximum": 1
      },
      "fightConfidence": {
        "type": "number",
        "title": "打架分类置信度",
        "minimum": 0.01,
        "maximum": 1
      },
      "maxPairs": {
        "type": "integer",
        "title": "每帧最多分析人员对",
        "minimum": 1,
        "maximum": 4
      }
    }
  },
  "defaultParameters": {
    "personConfidence": 0.5,
    "fightConfidence": 0.85,
    "maxPairs": 2
  },
  "defaultRule": {
    "schemaVersion": "1.0",
    "eventType": "FIGHTING",
    "severity": "MAJOR",
    "cooldownSeconds": 60,
    "recoverySeconds": 5,
    "dedup": {
      "scope": "TRACK",
      "windowSeconds": 60
    },
    "schedule": {
      "timezone": "Asia/Shanghai",
      "weekly": [
        {
          "days": [
            1,
            2,
            3,
            4,
            5,
            6,
            7
          ],
          "start": "00:00",
          "end": "23:59"
        }
      ]
    },
    "regions": [
      {
        "id": "main",
        "name": "检测区域",
        "type": "POLYGON",
        "pointMode": "CENTROID",
        "overlapThreshold": 0.2,
        "sourceWidth": 1920,
        "sourceHeight": 1080,
        "points": [
          {
            "x": 0,
            "y": 0
          },
          {
            "x": 1,
            "y": 0
          },
          {
            "x": 1,
            "y": 1
          },
          {
            "x": 0,
            "y": 1
          }
        ]
      }
    ],
    "condition": {
      "type": "AND",
      "children": [
        {
          "type": "ROI_ENTER",
          "regionId": "main",
          "objectClasses": [
            "fighting"
          ]
        },
        {
          "type": "N_OF_M",
          "n": 3,
          "m": 5
        },
        {
          "type": "DURATION",
          "seconds": 5
        }
      ]
    }
  }
}
