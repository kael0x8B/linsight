MYSQL_PORT=23306
MYSQL_ROOT_PASSWORD=linsight_dev
REDIS_PORT=26379
MINIO_API_PORT=29000
MINIO_CONSOLE_PORT=29001
MINIO_ROOT_USER=linsight
MINIO_ROOT_PASSWORD=linsight_minio_dev
# 跨机器部署节点时填写节点可访问的 MinIO API 地址，例如 http://192.168.1.20:29000。
# 留空时使用 http://127.0.0.1:${MINIO_API_PORT}，仅适用于同机。
LINSIGHT_MODEL_PUBLIC_ENDPOINT=
BACKEND_PORT=48888
FRONTEND_PORT=5666
LINSIGHT_RUNTIME_ENABLED=false
LINSIGHT_RUNTIME_BASE_URL=http://127.0.0.1:48900
LINSIGHT_RUNTIME_API_KEY=
LINSIGHT_RUNTIME_MODEL_POOL_SIZE=4
LINSIGHT_RUNTIME_MODEL_MEMORY_SAFETY_RATIO=0.05
LINSIGHT_RUNTIME_MODEL_MEMORY_MIN_RESERVE_MIB=512

# 网关本地历史保留天数；平台待补传证据不会在 ACK 前清理。
LINSIGHT_RUNTIME_GATEWAY_HISTORY_DAYS=7
# The existing Runtime process automatically serves the authenticated local console.
LINSIGHT_RUNTIME_GATEWAY_CONSOLE_ENABLED=true
LINSIGHT_RUNTIME_GATEWAY_CONSOLE_HOST=0.0.0.0
LINSIGHT_RUNTIME_GATEWAY_CONSOLE_PORT=48901
LINSIGHT_RUNTIME_GATEWAY_EVENT_TCP_HOST=0.0.0.0
LINSIGHT_RUNTIME_GATEWAY_EVENT_TCP_PORT=48902
