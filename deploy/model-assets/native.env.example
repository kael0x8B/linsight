# The connection must match the database used by IDEA / application-local.yaml.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=linsight
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME
# Optional CA certificate for a MySQL server requiring verified TLS.
MYSQL_SSL_CA=

# MinIO API endpoint (usually 9000), not its web console (usually 9001).
# This address must also be reachable from the Java backend.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
# Leave empty to use MINIO_ENDPOINT; otherwise specify the address reachable by nodes.
LINSIGHT_MODEL_PUBLIC_ENDPOINT=

# 完整业务快照恢复时，同时生成 IDEA local profile 的数据库和 Redis 配置。
# Redis 本机默认 6379；远程安装请填写实际地址、端口和密码。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
# MySQL 使用 TLS 等额外参数时，可设置后端完整 JDBC URL；空值按上述 MySQL 参数生成。
DB_URL=
